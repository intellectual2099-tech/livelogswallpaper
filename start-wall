#!/usr/bin/env bash
# GHOST OPS TERMINAL - live hacker log wallpaper
# Usage:
#   ./start-wall        -> set as desktop wallpaper (X11 session required)
#   ./start-wall -p     -> preview as a normal window (works on Wayland too)
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PIDFILE="$DIR/.wall.pid"

usage() {
    sed -n '2,3p' "$0"
    exit 0
}

stop_wall() {
    if [[ -f "$PIDFILE" ]]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
    pkill -f "wall.py" 2>/dev/null || true
    wait
}

case "${1:-}" in
    stop|-s|--stop) stop_wall; exit 0 ;;
    help|-h|--help) usage ;;
esac

stop_wall

if [[ "$1" == "-p" || "$1" == "--preview" ]]; then
    echo "[+] preview mode (normal window)"
    exec python3 "$DIR/wall.py" --preview --size 1280x800
fi

SESSION_TYPE="${XDG_SESSION_TYPE:-}"

if [[ "$SESSION_TYPE" == *wayland* ]] && ! command -v Xwayland >/dev/null 2>&1; then
    echo "[!] Wayland session without Xwayland -- the wallpaper needs an X11 session."
    echo "    Log out, pick 'GNOME' (Xorg) at the login screen, then rerun ./start-wall"
    exit 1
fi

# Always detect the real screen size so the wallpaper matches the user's display,
# whichever method the environment supports. Fallbacks are tried in order so this
# works at login (xrandr may not be ready yet) and on minimal setups.
detect_geo() {
    local g
    g="$(xrandr --current 2>/dev/null | awk -F'[ +]' '/ connected primary/{print $4; exit}')"
    [[ "$g" =~ ^[0-9]+x[0-9]+$ ]] && { echo "$g"; return; }
    g="$(xrandr --current 2>/dev/null | awk -F'[ +]' '/ connected/{print $4; exit}')"
    [[ "$g" =~ ^[0-9]+x[0-9]+$ ]] && { echo "$g"; return; }
    g="$(xwininfo -root 2>/dev/null | awk '/-geometry/{gsub(/\+.*/,"",$2); print $2; exit}')"
    [[ "$g" =~ ^[0-9]+x[0-9]+$ ]] && { echo "$g"; return; }
    g="$(xdpyinfo 2>/dev/null | awk '/dimensions:/{print $2"x"$6; exit}')"
    [[ "$g" =~ ^[0-9]+x[0-9]+$ ]] && { echo "$g"; return; }
    echo ""
}
GEO="$(detect_geo)"
if [[ "$GEO" =~ ^[0-9]+x[0-9]+$ ]]; then
    echo "[+] wallpaper size: $GEO"
else
    echo "[!] could not auto-detect screen size; defaulting to 1920x1080 (may be wrong for your display)"
    GEO="1920x1080"
    echo "[+] wallpaper size: $GEO (default)"
fi

XW="$(command -v xwinwrap || echo "$DIR/xwinwrap")"
if [[ ! -x "$XW" ]]; then
    echo "[!] xwinwrap not found. Build it: cd /tmp/opencode/xwinwrap && make"
    echo "    or install: sudo apt install xwinwrap"
    exit 1
fi

echo "[+] launching wallpaper (xwinwrap + wall.py)"
WALL_OK=""
for attempt in 1 2 3; do
    stop_wall 2>/dev/null || true
    sleep 0.5
    setsid nohup "$XW" \
        -ni -b -nf -un -s -st -sp -argb \
        -g "$GEO+0+0" \
        -- python3 "$DIR/wall.py" --wid WID --size "$GEO" \
        >> "$DIR/.wall.log" 2>&1 < /dev/null &
    echo $! > "$PIDFILE"
    # tell KWin it's a *desktop* window: full-screen on the primary monitor,
    # pinned behind everything. (Without this, KWin sizes/places it arbitrarily.)
    WID=""
    for _ in 1 2 3 4 5 6 7 8; do
        WID="$(timeout 5 xwininfo -root -tree 2>/dev/null | grep 'GHOST OPS' | awk '{print $1}')"
        [[ -n "$WID" ]] && break
        sleep 1
    done
    if [[ -n "$WID" ]]; then
        xprop -id "$WID" -f _NET_WM_WINDOW_TYPE 32a \
            -set _NET_WM_WINDOW_TYPE _NET_WM_WINDOW_TYPE_DESKTOP \
            && echo "[+] wallpaper on desktop layer" || true
    fi
    sleep 1
    if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        WALL_OK=1
        break
    fi
    echo "[!] attempt $attempt failed; retrying..."
    rm -f "$PIDFILE"
done

if [[ -n "$WALL_OK" ]]; then
    echo "[+] wallpaper running (pid $(cat "$PIDFILE"))"
    echo "    stop it anytime:  $DIR/start-wall stop"
else
    echo "[!] failed to start. check $DIR/.wall.log"
    exit 1
fi